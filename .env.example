# Copy to .env and fill in. Never commit .env.

# Weather provider: auto | qweather | openmeteo | fake
# auto = qweather when QWEATHER_KEY and QWEATHER_HOST are set, otherwise openmeteo (no key needed)
WEATHER_PROVIDER=auto

# QWeather (https://console.qweather.com): API key and your personal API Host
QWEATHER_KEY=
QWEATHER_HOST=

# Qingdao. LOCATION is the QWeather location id; LAT/LON are used by Open-Meteo,
# QWeather air quality and weather alerts.
LOCATION=101120201
LAT=36.07
LON=120.38
CITY_NAME=青岛

# Clockwise rotation applied to the landscape image before it is sent to the Kindle (90 or 270).
ROTATE=90

RENDER_INTERVAL_MIN=15
NIGHT_START=23:00
NIGHT_END=06:00

# Device policy, sent to the Kindle through GET /api/plan. Change it here, then
# `docker restart` -- the device needs no new file.
#   CLOCK_ENABLED=1        blit the HH:MM strip every minute
#   FULL_REFRESH_EVERY=24  after N partial updates, do one flashing repaint
CLOCK_ENABLED=1
FULL_REFRESH_EVERY=24

# 1 = stop refreshing the poster between NIGHT_START and NIGHT_END (the clock patch keeps
# ticking either way, so the screen still reads as a clock). 0 = keep the full 15-minute
# cadence all night, which is what a deskside clock wants.
NIGHT_SLEEP=0

# Front light schedule: "HH:MM=level" pairs, comma separated, wrapping past midnight.
# Use "user" for the level picked on /light. Empty means the two-point default built from
# LIGHT_NIGHT_AUTO / NIGHT_START / NIGHT_END / NIGHT_LIGHT_LEVEL below.
#   LIGHT_SCHEDULE=07:00=12,21:00=6,23:30=2,06:00=user
LIGHT_SCHEDULE=

# Only used when LIGHT_SCHEDULE is empty: dim to NIGHT_LIGHT_LEVEL between NIGHT_START and
# NIGHT_END, back to the user's level in the morning. LIGHT_NIGHT_AUTO is the master
# switch and only seeds the default -- the phone page has a checkbox that overrides it.
LIGHT_NIGHT_AUTO=1
NIGHT_LIGHT_LEVEL=3

# Optional shared secret: when set, every endpoint except /healthz needs ?token=...
TOKEN=
